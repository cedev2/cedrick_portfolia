# API base URL. Leave empty to use the same origin (Vite proxies /api in dev).
# In production (Vercel) set this to the public backend origin, e.g.
# https://your-api.onrender.com — it is baked in at build time, so redeploy
# after changing it.
VITE_API_URL=

# Target the Vite dev proxy should forward /api and /uploads to.
VITE_API_TARGET=http://localhost:4000
