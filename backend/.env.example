# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY=86400

# AI Configuration - EJOLABS (Primary AI Provider)
EJOLABS_API_KEY=

# Uploads
UPLOAD_MAX_SIZE=20971520

# Admin bootstrap account (used by `npm run seed`)
ADMIN_USERNAME=cedev
ADMIN_EMAIL=cedrickrwa@gmail.com
ADMIN_PASSWORD=Pcoding52!
ADMIN_FULL_NAME=NIBISHAKA CEDRICK
